EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Maps Platform (funciones Premium: sugerencias de dirección y medidas de
# distancia/tiempo). Habilita SOLO estas dos APIs en Google Cloud (son las que usa
# el código; el resto son legacy y no hacen falta):
#   - Places API (New)   [places.googleapis.com]
#       -> autocompletado (POST /v1/places:autocomplete) y detalle del lugar
#          (GET /v1/places/{placeId})
#   - Routes API         [routes.googleapis.com]
#       -> distancia y duración (POST /directions/v2:computeRoutes)
#
# NO habilites: "Places API" (la legacy, places-backend.googleapis.com),
# "Distance Matrix API", "Directions API", "Geocoding API", "Maps JavaScript API",
# "Maps SDK for Android/iOS" ni "Places SDK": todas son legacy o no se usan.
#
# Restricción de la key:
#   1) Restricciones de aplicación -> "Sitios web": incluye el dominio de
#      producción Y el origen del servidor de desarrollo (el navegador recorta el
#      Referer al origen, así que no sirve restringir por rutas):
#         https://whatsremisse.tech/*
#         https://*.whatsremisse.tech/*
#         http://2.25.124.107:19006/*      <- dev server (borrar en producción)
#   2) Restricciones de API -> limitar la key a Places API (New) + Routes API.
#   Para la app nativa, más adelante: keys aparte con package + SHA-1 (Android) y
#   bundle ID (iOS). Ojo: App Check no protege llamadas REST con API key.
#   Recomendado: poner cuota diaria a la key y alerta de presupuesto en Cloud.
#
# Precios de referencia (USD por 1000 llamadas, con cupo gratuito mensual):
#   autocompletado $2.83 (10k gratis) · detalle del lugar $5 (10k gratis)
#   rutas: Essentials $5 (10k gratis) / Pro $10 si se pide con tráfico
# El autocompletado y el detalle de la sugerencia elegida se cobran como UNA
# sesión (ver lib/places.ts); abandonarla o reutilizar el token se cobra por
# petición.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Verificación por SMS (pon "false" para saltarla en desarrollo).
EXPO_PUBLIC_REQUIRE_SMS_VERIFICATION=true
